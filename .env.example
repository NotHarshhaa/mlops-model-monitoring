# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list, or * to allow any origin during local development.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Dataset and reference data
# ---------------------------------------------------------------------------
DATASET_PATH=data/breast_cancer.csv
TARGET_COLUMN=target
TEST_SIZE=0.2
RANDOM_STATE=42
REFERENCE_DATA_PATH=data/reference.csv

# ---------------------------------------------------------------------------
# Model artifact
# ---------------------------------------------------------------------------
MODEL_NAME=baseline-classifier
# Leave blank to generate a timestamp-based version when training.
MODEL_VERSION=
MODEL_PATH=artifacts/model

# ---------------------------------------------------------------------------
# Inference and prediction logging
# ---------------------------------------------------------------------------
PREDICTION_LOG_PATH=artifacts/predictions.jsonl
PREDICTION_LOG_ENABLED=true
MAX_BATCH_SIZE=1000

# ---------------------------------------------------------------------------
# Monitoring and alert thresholds
# ---------------------------------------------------------------------------
MONITORING_ENABLED=true
DRIFT_REPORT_PATH=reports/drift-report.html
MONITORING_REPORT_PATH=reports/monitoring-report.json
MONITORING_METRICS_PATH=reports/monitoring.prom
# PSI at or above this value marks an individual feature as drifted.
DRIFT_THRESHOLD=0.2
# Share of drifted features required to flag dataset drift.
DRIFT_SHARE_THRESHOLD=0.3
# Relative performance drop (0.10 = 10%) that triggers an alert.
PERFORMANCE_DROP_THRESHOLD=0.1

# ---------------------------------------------------------------------------
# Training gates
# ---------------------------------------------------------------------------
MIN_F1=0.80
MIN_RECALL=0.75
MIN_ROC_AUC=0.85
# Candidate may trail the in-run baseline by at most this much F1.
BASELINE_TOLERANCE=0.01

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
MLFLOW_ENABLED=true
# Leave blank to use a local ./mlruns file store.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=mlops-model-monitoring
MLFLOW_REGISTER_MODEL=false
